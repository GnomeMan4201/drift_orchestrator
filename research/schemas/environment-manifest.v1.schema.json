{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GnomeMan4201/drift_orchestrator/blob/main/research/schemas/environment-manifest.v1.schema.json",
  "title": "Second-Order Injection experiment environment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "captured_at",
    "repository",
    "host",
    "python",
    "ollama",
    "models",
    "gateway",
    "sampling",
    "run"
  ],
  "properties": {
    "schema_version": {
      "const": "environment-manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit", "dirty"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "diff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "architecture", "cpu", "ram_bytes"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "kernel": {"type": ["string", "null"]},
        "architecture": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "ram_bytes": {"type": "integer", "minimum": 1},
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "driver": {"type": ["string", "null"]},
              "memory_bytes": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "implementation", "dependency_lock_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ollama": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "minLength": 1}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "digest"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "digest": {
            "type": "string",
            "pattern": "^(sha256:)?[0-9a-f]{64}$"
          },
          "size_bytes": {"type": ["integer", "null"], "minimum": 1},
          "modelfile_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_sha256", "routes"],
      "properties": {
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "model_role"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "model_role": {"type": "string", "minLength": 1},
              "url": {
                "type": ["string", "null"],
                "format": "uri"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "seed_policy"],
      "properties": {
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "top_k": {"type": ["integer", "null"], "minimum": 0},
        "seed": {"type": ["integer", "null"]},
        "seed_policy": {
          "enum": ["fixed", "varied", "runtime_default", "unsupported"]
        },
        "other": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "online",
        "scripts",
        "planned_repetitions",
        "completed_repetitions"
      ],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "online": {"type": "boolean"},
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "planned_repetitions": {"type": "integer", "minimum": 1},
        "completed_repetitions": {"type": "integer", "minimum": 0},
        "deviations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
